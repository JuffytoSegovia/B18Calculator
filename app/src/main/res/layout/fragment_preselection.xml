<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    android:id="@+id/scrollViewPreselection"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/calculadora_preseleccion_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <!-- Ventana 1: Inicio -->
        <LinearLayout
            android:id="@+id/layoutInicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/nombre_hint"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutModalidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

                <AutoCompleteTextView
                    android:id="@+id/spinnerModalidad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:hint="@string/modalidad_hint"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextENP"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:hint="@string/enp_hint"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutSisfoh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

                <AutoCompleteTextView
                    android:id="@+id/spinnerSisfoh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:hint="@string/sisfoh_hint"/>
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutDepartamento"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

                    <AutoCompleteTextView
                        android:id="@+id/spinnerDepartamento"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:hint="@string/departamento_hint"/>
                </com.google.android.material.textfield.TextInputLayout>

                <ImageButton
                    android:id="@+id/buttonInfoQuintil"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_question"
                    android:contentDescription="@string/info_quintil_description"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="8dp"/>
            </LinearLayout>

            <Button
                android:id="@+id/buttonContinuar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/continuar"
                style="@style/Widget.MaterialComponents.Button"/>

            <Button
                android:id="@+id/buttonLimpiar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/limpiar"
                android:layout_marginTop="8dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

        </LinearLayout>

        <!-- Ventana 2: Continuación -->
        <LinearLayout
            android:id="@+id/layoutContinuacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/participaci_n_en_actividades_extracurriculares_m_ximo_10_puntos"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"/>

            <CheckBox
                android:id="@+id/checkboxConcursoNacional"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ce_concurso_escolar_nacional_1_2_o_3_puesto_etapa_nacional_o_concurso_escolar_internacional_5_puntos"/>

            <CheckBox
                android:id="@+id/checkboxConcursoParticipacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cep_participaci_n_en_la_etapa_nacional_de_los_concursos_escolares_nacionales_2_puntos"/>

            <CheckBox
                android:id="@+id/checkboxJuegosNacionales"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/jd_juegos_deportivos_escolares_1_2_o_3_puesto_en_etapa_nacional_5_puntos"/>

            <CheckBox
                android:id="@+id/checkboxJuegosParticipacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/jdp_participaci_n_en_la_etapa_nacional_de_los_juegos_deportivos_escolares_nacionales_2_puntos"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/otras_condiciones_priorizables_m_ximo_25_puntos"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"/>

            <CheckBox
                android:id="@+id/checkboxDiscapacidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/d_discapacidad_5_puntos"/>

            <CheckBox
                android:id="@+id/checkboxBomberos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/b_bomberos_activos_e_hijos_de_bomberos_5_puntos"/>

            <CheckBox
                android:id="@+id/checkboxVoluntarios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/v_voluntarios_reconocidos_por_el_mimp_5_puntos"/>

            <CheckBox
                android:id="@+id/checkboxComunidadNativa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ia_pertenencia_a_comunidad_nativa_amaz_nica_o_poblaci_n_afroperuana_5_puntos"/>

            <CheckBox
                android:id="@+id/checkboxMetalesPesados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pem_poblaci_n_expuesta_a_metales_pesados_y_otras_sustancias_qu_micas_5_puntos"/>

            <CheckBox
                android:id="@+id/checkboxPoblacionBeneficiaria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pd_poblaci_n_beneficiaria_res_suprema_n_264_2022_jus_5_puntos"/>

            <CheckBox
                android:id="@+id/checkboxOrfandad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/or_poblaci_n_beneficiaria_de_la_ley_n_31405_orfandad_5_puntos"/>

            <CheckBox
                android:id="@+id/checkboxDesproteccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/df_desprotecci_n_familiar_5_puntos"/>

            <CheckBox
                android:id="@+id/checkboxAgenteSalud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/acs_agente_comunitario_de_salud_5_puntos"/>

            <LinearLayout
                android:id="@+id/layoutLenguaOriginaria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_marginTop="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

                    <AutoCompleteTextView
                        android:id="@+id/spinnerLenguaOriginaria"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:hint="@string/priorizaci_n_de_lengua_originaria"/>
                </com.google.android.material.textfield.TextInputLayout>

                <ImageButton
                    android:id="@+id/buttonInfoLengua"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_question"
                    android:contentDescription="@string/informaci_n_sobre_lenguas_originarias"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="8dp"/>
            </LinearLayout>

            <Button
                android:id="@+id/buttonCalcular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/calcular"
                android:layout_marginTop="16dp"
                style="@style/Widget.MaterialComponents.Button"/>
        </LinearLayout>

        <!-- Ventana 3: Resultado (continuación) -->
        <LinearLayout
            android:id="@+id/layoutResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/textViewNombreResultado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/buttonPuntajeResultado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/desglose_del_puntaje"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/textViewDesglosePuntaje"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/textViewFormula"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="italic"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/textViewPuntajeMaximo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/textViewMensajeAnimo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                android:textIsSelectable="true"
                android:autoLink="all"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/buttonSimulacrosPDF"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/acceder_a_simulacros_pdf"
                    android:layout_marginBottom="8dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

                <Button
                    android:id="@+id/buttonSimulacroOnline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/practicar_simulacro_en_l_nea"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            </LinearLayout>

            <Button
                android:id="@+id/buttonReiniciar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reiniciar"
                style="@style/Widget.MaterialComponents.Button"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>